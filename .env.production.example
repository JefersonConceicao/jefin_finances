APP_NAME="Jefin Finances"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://SEU_DOMINIO

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jefin_finances
DB_USERNAME=jefin
DB_PASSWORD=
# Só o container do MySQL usa; o Laravel conecta com DB_USERNAME
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# O Caddy termina o HTTPS na frente do nginx
SESSION_SECURE_COOKIE=true
TRUSTED_PROXIES=*

MAIL_DRIVER=log
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

JWT_SECRET=

DEBUGBAR_ENABLED=false
